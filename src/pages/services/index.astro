---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/services';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://apr-handyman.com/' },
  { name: 'Services', url: 'https://apr-handyman.com/services' },
]);
---

<Layout
  title="Handyman & Home Improvement Services Jacksonville FL | APR Handyman"
  description="Complete handyman and remodeling services in Jacksonville, FL. Painting, carpentry, bathroom renovations, deck repair, maintenance & more. Licensed & insured. Free estimates."
  canonical="/services"
  schema={breadcrumbSchema}
>
  <!-- Page Header -->
  <section class="bg-navy-800 text-white py-16 lg:py-20" aria-labelledby="services-page-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </li>
          <li class="text-gold-400 font-medium" aria-current="page">Services</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-block text-gold-400 font-semibold text-sm uppercase tracking-wider mb-3">What We Offer</span>
        <h1 id="services-page-heading" class="text-4xl lg:text-5xl font-bold mb-4">
          Professional Home Services in Jacksonville, FL
        </h1>
        <p class="text-gray-300 text-lg leading-relaxed">
          From minor repairs to complete remodels, APR Handyman delivers expert craftsmanship with German precision across Jacksonville and all of Northeast Florida. Every service, every time.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 lg:py-24 bg-gray-50" aria-labelledby="all-services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 id="all-services-heading" class="text-3xl font-bold text-navy-900 mb-4">
          All Services — Jacksonville & NE Florida
        </h2>
        <p class="text-gray-600">
          Click any service below to learn more about what we do, the specific tasks we handle, and how we serve your neighborhood.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service) => (
          <ServiceCard
            slug={service.slug}
            title={service.title}
            shortTitle={service.shortTitle}
            description={service.description}
            icon={service.icon}
            features={service.features}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose APR -->
  <section class="py-16 bg-white" aria-labelledby="why-apr-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 id="why-apr-heading" class="text-3xl font-bold text-navy-900 mb-4">
          Why Jacksonville Homeowners Choose APR Handyman
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" /></svg>`,
            title: 'German Precision',
            desc: 'Owner Tolga Gürsoy brings 20+ years of European craftsmanship standards to every Jacksonville project. Proper prep, right materials, perfect execution.',
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
            title: 'Licensed & Insured',
            desc: 'Fully licensed and insured for your peace of mind. We carry complete general liability insurance and can provide certificates on request.',
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
            title: 'Transparent Pricing',
            desc: 'Written estimates with clear itemization. You know exactly what you\'re paying for before we start. No hidden fees, no surprises at invoice time.',
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>`,
            title: 'Truly Local',
            desc: 'We live and work in Jacksonville. We know the neighborhoods, the climate challenges, and the specific needs of Northeast Florida homes.',
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>`,
            title: '4.9 Star Rated',
            desc: 'Consistently rated 4.9/5 stars by Jacksonville homeowners. Our reviews reflect our commitment to quality work and honest service.',
          },
          {
            icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>`,
            title: '24/7 Emergency',
            desc: 'Home emergencies don\'t wait for business hours. Emergency contact available 24/7 for urgent situations that can\'t wait until Monday.',
          },
        ].map((item) => (
          <div class="flex items-start gap-4 p-6 bg-gray-50 rounded-2xl border border-gray-100">
            <div class="w-12 h-12 bg-navy-800 rounded-xl flex items-center justify-center flex-shrink-0">
              <div class="w-6 h-6 text-gold-400" set:html={item.icon} />
            </div>
            <div>
              <h3 class="font-bold text-navy-900 mb-1">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
