---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { buildBreadcrumbSchema } from '../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://apr-handyman.com/' },
  { name: 'Contact', url: 'https://apr-handyman.com/contact' },
]);
---

<Layout
  title="Contact APR Handyman | Free Estimates Jacksonville FL | (904) 532-6383"
  description="Contact APR Handyman for a free estimate on handyman or remodeling services in Jacksonville, FL. Call (904) 532-6383 or fill out our online form. Mon–Sat 8am–6pm."
  canonical="/contact"
  schema={breadcrumbSchema}
>
  <!-- Page Header -->
  <section class="bg-navy-800 text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-400">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg></li>
          <li class="text-gold-400 font-medium" aria-current="page">Contact</li>
        </ol>
      </nav>
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">Contact APR Handyman</h1>
      <p class="text-gray-300 text-lg max-w-2xl">
        Ready to start your project? Get a free estimate from Jacksonville's most trusted handyman service. We respond within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Info Sidebar -->
        <aside aria-label="Contact information">
          <!-- Contact Details -->
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6 mb-6">
            <h2 class="text-xl font-bold text-navy-900 mb-5">Get In Touch</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-navy-800 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-navy-900 text-sm mb-0.5">Phone</div>
                  <a href="tel:+19045326383" class="text-gray-700 hover:text-gold-600 transition-colors text-sm font-medium">(904) 532-6383</a>
                  <div class="text-gray-400 text-xs mt-0.5">Emergency contact 24/7</div>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-navy-800 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-navy-900 text-sm mb-0.5">Email</div>
                  <a href="mailto:Service@apr-handyman.com" class="text-gray-700 hover:text-gold-600 transition-colors text-sm break-all">Service@apr-handyman.com</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-navy-800 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-navy-900 text-sm mb-0.5">Service Area</div>
                  <div class="text-gray-700 text-sm">Jacksonville, FL & Northeast Florida</div>
                  <div class="text-gray-400 text-xs mt-0.5">Duval · Clay · St. Johns Counties</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Business Hours -->
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6 mb-6">
            <h3 class="text-base font-bold text-navy-900 mb-4">
              <svg class="w-5 h-5 text-gold-500 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Business Hours
            </h3>
            <div class="space-y-2 text-sm">
              {[
                { day: 'Monday', hours: '8:00 AM – 6:00 PM' },
                { day: 'Tuesday', hours: '8:00 AM – 6:00 PM' },
                { day: 'Wednesday', hours: '8:00 AM – 6:00 PM' },
                { day: 'Thursday', hours: '8:00 AM – 6:00 PM' },
                { day: 'Friday', hours: '8:00 AM – 6:00 PM' },
                { day: 'Saturday', hours: '8:00 AM – 6:00 PM' },
                { day: 'Sunday', hours: 'Closed (Emergency: 24/7)' },
              ].map((item) => (
                <div class={`flex items-center justify-between py-1.5 border-b border-gray-50 last:border-0 ${item.day === 'Sunday' ? 'text-gray-400' : 'text-gray-700'}`}>
                  <span class="font-medium">{item.day}</span>
                  <span>{item.hours}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Response time -->
          <div class="bg-gold-50 border border-gold-200 rounded-2xl p-5">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="text-sm font-semibold text-gold-900">Fast Response</p>
                <p class="text-xs text-gold-800 mt-0.5">We respond to all inquiries within 24 hours, Monday through Saturday. For urgent needs, call us directly.</p>
              </div>
            </div>
          </div>
        </aside>

        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-0" aria-labelledby="map-heading">
    <div class="bg-gray-100 h-80 relative" role="region" aria-label="Location map">
      <h2 id="map-heading" class="sr-only">APR Handyman Location Map — Jacksonville, FL</h2>
      <!--
        Google Maps Embed Placeholder
        To activate: Replace the src below with a real Google Maps embed URL
        Get your embed URL from: https://maps.google.com/
        Click "Share" → "Embed a map" → Copy the iframe src
        Example src: https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d...
      -->
      <iframe
        title="APR Handyman Service Area — Jacksonville, FL"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d222648.2793527217!2d-81.87395!3d30.33218!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88e5b716f1ceafeb%3A0xc4cd7d3896f2c905!2sJacksonville%2C%20FL!5e0!3m2!1sen!2sus!4v1699000000000!5m2!1sen!2sus"
        width="100%"
        height="320"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="w-full h-80"
      ></iframe>
    </div>
  </section>
</Layout>
