---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  publishDate: string;
  author: string;
  tags: string[];
  readingTime: number;
}

const { slug, title, excerpt, publishDate, author, tags, readingTime } = Astro.props;

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 hover:border-gold-300 flex flex-col">
  <!-- Image placeholder -->
  <a href={`/blog/${slug}`} class="block overflow-hidden bg-gray-100" aria-label={`Read: ${title}`}>
    <div class="relative h-48 bg-gradient-to-br from-navy-800 to-navy-700 flex items-center justify-center group-hover:opacity-90 transition-opacity">
      <div class="text-center px-6">
        <div class="inline-flex items-center gap-1 mb-2">
          {tags.slice(0, 2).map((tag) => (
            <span class="text-xs text-gold-400 bg-gold-500/20 px-2 py-0.5 rounded-full">{tag}</span>
          ))}
        </div>
      </div>
      <!-- Decorative pattern -->
      <div class="absolute inset-0 opacity-10" aria-hidden="true" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='1' fill-rule='evenodd'%3E%3Cpath d='M0 40L40 0H20L0 20M40 40V20L20 40'/%3E%3C/g%3E%3C/svg%3E&quot;)"></div>
    </div>
  </a>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <!-- Meta -->
    <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
      <time datetime={publishDate}>{formattedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} min read</span>
      <span aria-hidden="true">·</span>
      <span>{author}</span>
    </div>

    <!-- Title -->
    <h3 class="font-bold text-navy-900 text-lg leading-snug mb-3 group-hover:text-navy-700 transition-colors">
      <a href={`/blog/${slug}`} class="hover:underline decoration-gold-400 underline-offset-2">
        {title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class="text-gray-600 text-sm leading-relaxed mb-5 flex-1">
      {excerpt}
    </p>

    <!-- Tags + Read More -->
    <div class="flex items-center justify-between">
      <div class="flex gap-1.5 flex-wrap">
        {tags.slice(0, 2).map((tag) => (
          <span class="text-xs text-navy-700 bg-navy-50 px-2.5 py-1 rounded-full border border-navy-100">
            {tag}
          </span>
        ))}
      </div>
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center gap-1.5 text-navy-800 hover:text-gold-600 font-semibold text-sm transition-colors flex-shrink-0 group/link"
        aria-label={`Read full article: ${title}`}
      >
        Read More
        <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
