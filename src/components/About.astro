---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class={`${compact ? 'py-12 lg:py-16' : 'py-16 lg:py-24'} bg-white`} aria-labelledby="about-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image -->
      <div class="relative order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="/images/work-1.jpg"
            alt="Tolga Gürsoy, owner of APR Handyman, on a job site in Jacksonville, FL"
            class="w-full h-72 lg:h-96 object-cover"
            width="600"
            height="400"
            loading="lazy"
            onerror="this.style.display='none'"
          />
          <!-- Overlay badge -->
          <div class="absolute bottom-4 left-4 bg-navy-800/95 backdrop-blur-sm text-white rounded-xl p-4 max-w-xs">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gold-500 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-navy-900 font-bold text-lg">T</span>
              </div>
              <div>
                <div class="font-bold text-sm">Tolga Gürsoy</div>
                <div class="text-gray-300 text-xs">Owner & Master Craftsman</div>
                <div class="text-gold-400 text-xs">20+ Years Experience</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating stat cards -->
        <div class="absolute -top-4 -right-4 bg-white rounded-xl shadow-xl p-4 border border-gray-100 hidden lg:block">
          <div class="text-3xl font-bold text-navy-800">20+</div>
          <div class="text-xs text-gray-600">Years of Experience</div>
        </div>
        <div class="absolute -bottom-4 right-8 bg-gold-500 rounded-xl shadow-xl p-4 hidden lg:block">
          <div class="text-3xl font-bold text-navy-900">500+</div>
          <div class="text-xs text-navy-800 font-medium">Projects Completed</div>
        </div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2">
        <span class="inline-block text-gold-600 font-semibold text-sm uppercase tracking-wider mb-3">Our Story</span>
        <h2 id="about-heading" class="text-3xl lg:text-4xl font-bold text-navy-900 mb-6">
          German Precision Meets Jacksonville Hospitality
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed mb-8">
          <p>
            APR Handyman was founded by Tolga Gürsoy, a craftsman from Berlin, Germany who brought two decades of European woodworking and home improvement expertise to Jacksonville, Florida.
          </p>
          <p>
            In Germany, craftsmanship isn't just a job — it's a tradition of precision, quality materials, and work that stands the test of time. Tolga built his Jacksonville business on those same principles: meticulous preparation, honest communication, and results that clients are proud to show off years later.
          </p>
          {!compact && (
            <p>
              Today, APR Handyman serves homeowners across Jacksonville and Northeast Florida with the full range of home services — from minor repairs to complete remodels — with the same personal commitment Tolga brings to every job.
            </p>
          )}
        </div>

        <!-- Core Principles -->
        <div class="space-y-4 mb-8">
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 bg-navy-800 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy-900 text-sm mb-1">Quality Workmanship</h3>
              <p class="text-gray-600 text-sm">German precision applied to every project — proper preparation, right materials, flawless execution.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 bg-navy-800 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy-900 text-sm mb-1">Communication & Transparency</h3>
              <p class="text-gray-600 text-sm">You always know what's happening, what it costs, and what comes next. No surprises.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 bg-navy-800 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy-900 text-sm mb-1">Customer Satisfaction & Trust</h3>
              <p class="text-gray-600 text-sm">We're not done until you're genuinely delighted with the result. Your home, your investment, our responsibility.</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/about"
            class="inline-flex items-center justify-center gap-2 bg-navy-800 hover:bg-navy-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors"
          >
            Our Full Story
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 border-2 border-navy-800 text-navy-800 hover:bg-navy-800 hover:text-white font-semibold px-6 py-3 rounded-xl transition-colors"
          >
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
