---
import { testimonials } from '../data/testimonials';

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
const displayedTestimonials = testimonials.slice(0, limit);
---

<section class="py-16 lg:py-24 bg-navy-800 text-white" aria-labelledby="testimonials-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block text-gold-400 font-semibold text-sm uppercase tracking-wider mb-3">Client Reviews</span>
      <h2 id="testimonials-heading" class="text-3xl lg:text-4xl font-bold mb-4">
        What Jacksonville Homeowners Say
      </h2>
      <p class="text-gray-300 text-lg">
        Don't take our word for it — hear from homeowners across Jacksonville and Northeast Florida who trust APR Handyman with their most important investment.
      </p>
      <!-- Aggregate Rating -->
      <div class="flex items-center justify-center gap-3 mt-6">
        <div class="flex gap-1" aria-label="4.9 out of 5 stars">
          {[1,2,3,4,5].map((star) => (
            <svg class="w-6 h-6 text-gold-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-2xl font-bold">4.9</span>
        <span class="text-gray-400">· 47 Reviews</span>
      </div>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayedTestimonials.map((testimonial) => (
        <article class="bg-navy-700/50 backdrop-blur-sm rounded-2xl p-6 border border-navy-600 hover:border-gold-500/50 transition-colors">
          <!-- Stars -->
          <div class="flex gap-1 mb-4" aria-label={`${testimonial.rating} out of 5 stars`}>
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-gray-200 text-sm leading-relaxed mb-5">
            <svg class="w-6 h-6 text-gold-500/50 mb-2" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
            </svg>
            "{testimonial.text}"
          </blockquote>

          <!-- Author -->
          <footer class="flex items-center justify-between">
            <div>
              <div class="text-white font-semibold text-sm">{testimonial.name}</div>
              <div class="text-gray-400 text-xs">{testimonial.location}</div>
            </div>
            <div class="text-right">
              <div class="text-gold-400 text-xs font-medium">{testimonial.project}</div>
              <div class="text-gray-500 text-xs">{testimonial.date}</div>
            </div>
          </footer>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-12">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 font-bold px-8 py-4 rounded-xl transition-colors shadow-lg hover:shadow-xl"
      >
        Join Our Satisfied Customers
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a
        href="https://share.google/eELdcuHONKoJpBy2v"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-xl transition-colors border border-white/20 hover:border-gold-400/50"
        aria-label="See all APR Handyman reviews on Google (opens in new tab)"
      >
        <!-- Google Logo -->
        <svg viewBox="0 0 24 24" class="w-5 h-5 flex-shrink-0" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        See All Reviews on Google
      </a>
    </div>
  </div>
</section>
