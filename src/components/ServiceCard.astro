---
interface Props {
  slug: string;
  title: string;
  shortTitle: string;
  description: string;
  icon: string;
  features?: string[];
  compact?: boolean;
}

const { slug, title, description, icon, features = [], compact = false } = Astro.props;
---

<article class={`group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 hover:border-gold-300 flex flex-col ${compact ? 'p-5' : 'p-6'}`}>
  <!-- Icon -->
  <div class={`${compact ? 'w-12 h-12' : 'w-14 h-14'} bg-navy-800/5 group-hover:bg-navy-800/10 rounded-xl flex items-center justify-center mb-4 transition-colors flex-shrink-0`}>
    <div class={`${compact ? 'w-6 h-6' : 'w-7 h-7'} text-navy-800`} set:html={icon} aria-hidden="true" />
  </div>

  <!-- Content -->
  <div class="flex-1">
    <h3 class={`font-bold text-navy-900 mb-2 ${compact ? 'text-base' : 'text-lg'}`}>
      {title}
    </h3>
    <p class={`text-gray-600 leading-relaxed mb-4 ${compact ? 'text-sm' : 'text-sm'}`}>
      {description}
    </p>

    {!compact && features.length > 0 && (
      <ul class="space-y-1.5 mb-5">
        {features.slice(0, 4).map((feature) => (
          <li class="flex items-start gap-2 text-sm text-gray-600">
            <svg class="w-4 h-4 text-gold-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            {feature}
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- CTA -->
  <a
    href={`/services/${slug}`}
    class="inline-flex items-center gap-1.5 text-navy-800 hover:text-gold-600 font-semibold text-sm transition-colors group/link mt-auto"
    aria-label={`Learn more about ${title}`}
  >
    Learn More
    <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </a>
</article>
