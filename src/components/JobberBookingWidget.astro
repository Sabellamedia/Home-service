---
/**
 * Jobber Booking Widget Component
 *
 * This component embeds Jobber's online booking widget, allowing clients
 * to request work directly through your Jobber account.
 *
 * SETUP INSTRUCTIONS:
 * 1. Log into your Jobber account at app.getjobber.com
 * 2. Go to Settings → Client Hub → Online Booking
 * 3. Enable online booking and copy your Client Hub ID
 * 4. Set PUBLIC_JOBBER_ENABLED=true in your .env file
 * 5. Replace YOUR_CLIENT_HUB_ID below with your actual Client Hub ID
 *
 * The booking widget URL format:
 * https://clienthub.getjobber.com/client_hubs/{CLIENT_HUB_ID}/public/work_request/new
 *
 * Documentation: https://help.getjobber.com/hc/en-us/articles/1500002452801
 */

const JOBBER_CLIENT_HUB_ID = import.meta.env.PUBLIC_JOBBER_CLIENT_HUB_ID ?? 'YOUR_CLIENT_HUB_ID';
const JOBBER_ENABLED = import.meta.env.PUBLIC_JOBBER_ENABLED === 'true';
const bookingUrl = `https://clienthub.getjobber.com/client_hubs/${JOBBER_CLIENT_HUB_ID}/public/work_request/new`;
---

{JOBBER_ENABLED ? (
  <div class="jobber-booking-widget rounded-2xl overflow-hidden shadow-xl border border-gray-200">
    <div class="bg-navy-800 text-white px-6 py-4">
      <h3 class="font-bold text-lg">Book Online with Jobber</h3>
      <p class="text-gray-300 text-sm">Schedule your service request instantly</p>
    </div>
    <!-- Jobber booking widget iframe -->
    <iframe
      src={bookingUrl}
      title="APR Handyman Online Booking"
      width="100%"
      height="700"
      frameborder="0"
      allowfullscreen
      class="w-full"
      loading="lazy"
    ></iframe>
    <p class="text-xs text-gray-400 px-4 py-2 text-center">
      Powered by <a href="https://getjobber.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-600">Jobber</a>
    </p>
  </div>
) : (
  <!-- Fallback: show contact form instead -->
  <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
    <svg class="w-8 h-8 text-amber-500 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
    </svg>
    <h3 class="font-bold text-amber-900 mb-2">Online Booking Coming Soon</h3>
    <p class="text-amber-800 text-sm mb-4">
      Our online booking system is being set up. In the meantime, please use the contact form below or call us directly.
    </p>
    <a
      href="tel:+19045326383"
      class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition-colors"
    >
      Call (904) 532-6383
    </a>
    <!-- Developer note: Set PUBLIC_JOBBER_ENABLED=true in .env to enable the Jobber widget -->
  </div>
)}
