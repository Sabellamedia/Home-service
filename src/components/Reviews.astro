---
// Google Reviews / Testimonials showcase section
// Replace with actual Google Reviews API data when available

const stats = [
  { value: '4.9', label: 'Average Rating', suffix: '/5' },
  { value: '47', label: 'Google Reviews', suffix: '+' },
  { value: '20', label: 'Years Experience', suffix: '+' },
  { value: '500', label: 'Projects Completed', suffix: '+' },
];
---

<section class="py-12 bg-white border-t border-b border-gray-100" aria-labelledby="reviews-stats-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 id="reviews-stats-heading" class="text-2xl font-bold text-navy-900 mb-2">
        Trusted by Jacksonville Homeowners
      </h2>
      <p class="text-gray-600">
        APR Handyman has earned a reputation for quality and reliability across Northeast Florida.
      </p>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mb-10">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="flex items-end justify-center gap-0.5">
            <span class="text-4xl lg:text-5xl font-bold text-navy-800">{stat.value}</span>
            <span class="text-2xl font-bold text-gold-500 mb-1">{stat.suffix}</span>
          </div>
          <p class="text-gray-600 text-sm mt-1">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Google Review Badge + Link -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
      <div class="flex items-center gap-3 bg-gray-50 rounded-xl px-5 py-3 border border-gray-200">
        <!-- Google Logo SVG -->
        <svg viewBox="0 0 24 24" class="w-6 h-6 flex-shrink-0" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <div>
          <div class="flex items-center gap-1">
            {[1,2,3,4,5].map((star) => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
            <span class="text-sm font-semibold text-gray-900 ml-1">4.9</span>
          </div>
          <p class="text-xs text-gray-500">47 Google reviews</p>
        </div>
      </div>
      <a
        href="https://www.google.com/maps/place/APR+Handyman"
        target="_blank"
        rel="noopener noreferrer"
        class="text-navy-800 hover:text-gold-600 font-medium text-sm transition-colors underline underline-offset-2"
        aria-label="View APR Handyman reviews on Google (opens in new tab)"
      >
        View all Google reviews →
      </a>
      <a
        href="https://www.google.com/maps/place/APR+Handyman"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium text-sm px-4 py-2 rounded-lg transition-colors border border-blue-200"
        aria-label="Leave a Google review for APR Handyman (opens in new tab)"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
        Leave a Review
      </a>
    </div>
  </div>
</section>
