---
interface Props {
  heading?: string;
  subheading?: string;
  primaryCTA?: string;
  primaryHref?: string;
  secondaryCTA?: string;
  secondaryHref?: string;
  variant?: 'gold' | 'navy' | 'light';
}

const {
  heading = 'Ready to Transform Your Jacksonville Home?',
  subheading = 'Get a free, no-obligation estimate from Jacksonville\'s most trusted handyman service. We respond within 24 hours.',
  primaryCTA = 'Get Free Estimate',
  primaryHref = '/contact#estimate',
  secondaryCTA = 'Call (904) 532-6383',
  secondaryHref = 'tel:+19045326383',
  variant = 'navy',
} = Astro.props;

const bgClass = {
  gold: 'bg-gold-500',
  navy: 'bg-navy-800',
  light: 'bg-gray-50 border border-gray-200',
}[variant];

const textClass = {
  gold: 'text-navy-900',
  navy: 'text-white',
  light: 'text-navy-900',
}[variant];

const subTextClass = {
  gold: 'text-navy-800/80',
  navy: 'text-gray-300',
  light: 'text-gray-600',
}[variant];

const primaryBtnClass = {
  gold: 'bg-navy-800 hover:bg-navy-700 text-white',
  navy: 'bg-gold-500 hover:bg-gold-400 text-navy-900',
  light: 'bg-navy-800 hover:bg-navy-700 text-white',
}[variant];

const secondaryBtnClass = {
  gold: 'bg-white/20 hover:bg-white/30 text-navy-900 border border-navy-800/30',
  navy: 'bg-white/10 hover:bg-white/20 text-white border border-white/30',
  light: 'bg-white hover:bg-gray-50 text-navy-800 border border-gray-300',
}[variant];
---

<section class={`py-14 lg:py-20 ${bgClass}`} aria-labelledby="cta-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 id="cta-heading" class={`text-3xl lg:text-4xl font-bold mb-4 ${textClass}`}>
      {heading}
    </h2>
    <p class={`text-lg mb-10 ${subTextClass} max-w-2xl mx-auto leading-relaxed`}>
      {subheading}
    </p>

    <!-- Trust signals -->
    <div class={`flex flex-wrap justify-center gap-6 mb-10 text-sm ${subTextClass}`}>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        Licensed & Insured
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Free Estimates
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
        </svg>
        4.9 Star Rating
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        24/7 Emergency Contact
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={primaryHref}
        class={`inline-flex items-center justify-center gap-2 font-bold px-8 py-4 rounded-xl text-base transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5 ${primaryBtnClass}`}
      >
        {primaryCTA}
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a
        href={secondaryHref}
        class={`inline-flex items-center justify-center gap-2 font-bold px-8 py-4 rounded-xl text-base transition-all duration-200 ${secondaryBtnClass}`}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        {secondaryCTA}
      </a>
    </div>
  </div>
</section>
