---
import { services } from '../data/services';
import { localAreas } from '../data/local-areas';

const serviceLinks = services.slice(0, 8);
const localLinks = localAreas.slice(0, 10);
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-900 text-gray-300" role="contentinfo">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand & Contact -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4" aria-label="APR Handyman Home">
          <img
            src="/images/logo.png"
            alt="APR Handyman Logo"
            width="120"
            height="34"
            class="h-8 w-auto brightness-0 invert"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <div class="hidden items-center gap-2">
            <div class="w-8 h-8 bg-gold-500 rounded flex items-center justify-center">
              <span class="text-navy-900 font-bold text-sm">A</span>
            </div>
            <span class="text-white font-bold text-base">APR Handyman</span>
          </div>
        </a>
        <p class="text-sm text-gray-400 mb-5 leading-relaxed">
          Premium handyman and remodeling services in Jacksonville, FL. German precision, 20+ years experience, and a commitment to your satisfaction.
        </p>

        <!-- NAP — Name, Address, Phone (critical for local SEO) -->
        <address class="not-italic text-sm space-y-2" itemscope itemtype="https://schema.org/LocalBusiness">
          <meta itemprop="name" content="APR Handyman" />
          <meta itemprop="alternateName" content="Almans Property Remodelling LLC" />
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 text-gold-500 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
              <span itemprop="addressLocality">Jacksonville</span>,
              <span itemprop="addressRegion">FL</span>
              <span itemprop="addressCountry" class="sr-only">US</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <a href="tel:+19045326383" class="hover:text-gold-400 transition-colors" itemprop="telephone">
              (904) 532-6383
            </a>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:Service@apr-handyman.com" class="hover:text-gold-400 transition-colors break-all text-xs" itemprop="email">
              Service@apr-handyman.com
            </a>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 text-gold-500 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs">
              Mon–Sat: 8am–6pm<br />
              Emergency contact: 24/7
            </span>
          </div>
        </address>

        <!-- Social -->
        <div class="flex gap-3 mt-5">
          <a
            href="https://www.instagram.com/apr_handyman"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 bg-navy-700 hover:bg-gold-500 rounded-lg flex items-center justify-center transition-colors group"
            aria-label="APR Handyman on Instagram"
          >
            <svg class="w-4 h-4 text-gray-300 group-hover:text-navy-900 transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Our Services</h3>
        <ul class="space-y-2">
          {serviceLinks.map((service) => (
            <li>
              <a href={`/services/${service.slug}`} class="text-sm hover:text-gold-400 transition-colors">
                {service.shortTitle}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-sm text-gold-500 hover:text-gold-400 transition-colors font-medium">
              View All Services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Service Areas</h3>
        <ul class="space-y-2">
          {localLinks.map((area) => (
            <li>
              <a href={`/local/${area.slug}`} class="text-sm hover:text-gold-400 transition-colors">
                {area.name}, FL
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-2 mb-6">
          <li><a href="/about" class="text-sm hover:text-gold-400 transition-colors">About Us</a></li>
          <li><a href="/blog" class="text-sm hover:text-gold-400 transition-colors">Blog & Tips</a></li>
          <li><a href="/contact" class="text-sm hover:text-gold-400 transition-colors">Contact Us</a></li>
          <li><a href="/contact#estimate" class="text-sm hover:text-gold-400 transition-colors">Free Estimate</a></li>
        </ul>

        <!-- CTA Box -->
        <div class="bg-navy-800 rounded-xl p-5 border border-navy-700">
          <p class="text-white font-semibold text-sm mb-1">Ready to get started?</p>
          <p class="text-gray-400 text-xs mb-4">Free estimates, no obligation.</p>
          <a
            href="/contact"
            class="block bg-gold-500 hover:bg-gold-400 text-navy-900 font-bold text-sm px-4 py-2.5 rounded-lg text-center transition-colors"
          >
            Get Free Estimate
          </a>
          <a
            href="tel:+19045326383"
            class="block mt-2 text-center text-gold-400 hover:text-gold-300 font-medium text-sm transition-colors"
          >
            (904) 532-6383
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500">
        <p>
          &copy; {currentYear} APR Handyman / Almans Property Remodelling LLC. All rights reserved.
        </p>
        <p>
          Jacksonville, FL · Licensed & Insured · Serving Northeast Florida
        </p>
      </div>
    </div>
  </div>
</footer>
